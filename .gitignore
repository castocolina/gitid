bin/
coverage.out

# goreleaser's own output directory (Phase 10 plan 10-04, D-05/REVIEW C-4) —
# distinct from bin/ so `make release`/`make release-snapshot`'s `--clean`
# never touches the Makefile's own build/build-cross output.
/dist/
# Root-level gitid binary from `go build ./cmd/gitid` or `go install`.
# Anchored with a leading slash so it does NOT match the cmd/gitid/ source directory.
/gitid

# Local scratch directory (screenshots, notes — not part of the repo).
/tmp/

# Local agent/tooling state — not repo content.
.claude/
.opencode/
.codegraph/
.playwright-mcp/
.agents/
skills-lock.json

# Local GSD runtime coordination.
.planning/milestone.lock

# Reproducible local evidence handoffs include compiled binaries and candidates.
.planning/phases/*/*-handoff/
.gsd/
graphify-out/
